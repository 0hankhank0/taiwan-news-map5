{
  "rewrites": [
    {
      "source": "/api/events",
      "destination": "/api/events.js"
    },
    {
      "source": "/api/admin-events",
      "destination": "/api/admin.js?adminRoute=events"
    },
    {
      "source": "/api/health",
      "destination": "/api/admin.js?adminRoute=health"
    },
    {
      "source": "/api/refresh-log",
      "destination": "/api/admin.js?adminRoute=refresh-log"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron.js"
    },
    {
      "source": "/api/submissions",
      "destination": "/api/submission.js"
    },
    {
      "source": "/api/submission-reports",
      "destination": "/api/submission.js?submissionReports=1"
    },
    {
      "source": "/api/reports/:reportId",
      "destination": "/api/admin.js?adminRoute=reports&reportId=:reportId"
    },
    {
      "source": "/api/reports",
      "destination": "/api/admin.js?adminRoute=reports"
    },
    {
      "source": "/api/submission-audit-log",
      "destination": "/api/submission.js?auditLog=1"
    },
    {
      "source": "/api/integrations/events/status",
      "destination": "/api/events.js?integrationStatus=1"
    },
    {
      "source": "/api/reactions/total",
      "destination": "/api/reactions-total.js"
    },
    {
      "source": "/event/:eventId",
      "destination": "/api/event-page.js?eventId=:eventId"
    },
    {
      "source": "/category/:categoryKey",
      "destination": "/api/event-page.js?categoryKey=:categoryKey"
    },
    {
      "source": "/video",
      "destination": "/index.html"
    },
    {
      "source": "/video/",
      "destination": "/index.html"
    }
  ]
}
